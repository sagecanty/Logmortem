{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOneLogGroupOnly",
      "Effect": "Allow",
      "Action": "logs:FilterLogEvents",
      "Resource": [
        "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:<LOG_GROUP_NAME>",
        "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:<LOG_GROUP_NAME>:*"
      ]
    }
  ]
}
